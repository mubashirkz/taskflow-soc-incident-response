        "data_source": {
          "type": "esql",
          "query": "FROM taskflow-logs\r\n| EVAL severity = CASE(\r\n    threat.indicator.type == \"phishing\", \"High\",\r\n    message LIKE \"*SQL injection*\" OR message LIKE \"*SQLi*\", \"High\",\r\n    event.outcome == \"failure\", \"Medium\",\r\n    \"Low\"\r\n  )\r\n| WHERE severity != \"Low\"\r\n| STATS event_count = COUNT(*) BY severity\r\n| SORT event_count DESC"
